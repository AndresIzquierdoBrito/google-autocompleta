{
  "name": "google-autocompleta-client",
  "main": "expo/AppEntry",
  "version": "1.0.0",
  "dependencies": {
    "@babel/runtime": "^7.14.0",
    "@react-native-async-storage/async-storage": "~1.15.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.15.1",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/node": "^26.2.0",
    "@types/react-native": "~0.64.38",
    "babel-preset-expo": "~57.0.11",
    "babel-plugin-module-resolver": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "NODE_OPTIONS=--openssl-legacy-provider expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "expo export --platform web --output-dir web-build && node scripts/patch-web-build.mjs",
    "api:types": "pnpm dlx openapi-typescript@7.13.0 http://127.0.0.1:8000/openapi.json -o src/api/schema.d.ts"
  },
  "private": true
}
